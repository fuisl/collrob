{
    "name": "ROS 2 Development Container",
    "privileged": true,
    "remoteUser": "fuisloy",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "fuisloy"
        }
    },
    "workspaceFolder": "/home/fuisloy/collrob",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/fuisloy/collrob,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
       "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
       "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    "postCreateCommand": "echo \"source /opt/ros/humble/setup.bash\" >> ~/.bashrc && rosdep update && rosdep install --from-paths src --ignore-src -y && sudo chown -R $(whoami) /home/fuisloy/collrob/"
}