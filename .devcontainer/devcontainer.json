{
    "name": "ROS 2 Development Container",
    "privileged": true,
    "remoteUser": "dev",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "dev",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "workspaceFolder": "/home/dev/collrob",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/collrob,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "compute,video,graphics,utility"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "--gpus=all"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    "postCreateCommand": "echo \"source /opt/ros/humble/setup.bash\" >> ~/.bashrc && rosdep update && rosdep install --from-paths src --ignore-src -y && sudo chown -R $(whoami) /home/$(whoami)/collrob/ && cd ~/turtlebot3_ws && colcon build --symlink-install --cmake-args -Wno-dev && echo 'source ~/turtlebot3_ws/install/setup.zsh' >> ~/.zshrc"
}